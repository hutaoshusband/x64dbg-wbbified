include_guard(GLOBAL)
include(FetchContent)

file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" mcp_dependency_record)
string(JSON mcp_dependency_schema GET "${mcp_dependency_record}" schemaVersion)
string(JSON mcp_dependency_count LENGTH "${mcp_dependency_record}" dependencies)
if(NOT mcp_dependency_schema EQUAL 1 OR NOT mcp_dependency_count EQUAL 4)
    message(FATAL_ERROR "Native MCP dependency record requires schema 1 and four dependency roles")
endif()
set(mcp_dependency_roles http json store javascript)
set(mcp_dependency_notices)
foreach(mcp_dependency_index RANGE 0 3)
    string(JSON mcp_dependency_role GET "${mcp_dependency_record}" dependencies ${mcp_dependency_index} role)
    if(NOT mcp_dependency_role IN_LIST mcp_dependency_roles OR DEFINED mcp_${mcp_dependency_role}_sourceUrl)
        message(FATAL_ERROR "Native MCP dependency roles must be known and unique: ${mcp_dependency_role}")
    endif()
    foreach(mcp_dependency_field sourceUrl archiveSha256 notice noticeSha256)
        string(JSON mcp_${mcp_dependency_role}_${mcp_dependency_field} GET "${mcp_dependency_record}" dependencies ${mcp_dependency_index} ${mcp_dependency_field})
    endforeach()
    foreach(mcp_digest_field archiveSha256 noticeSha256)
        set(mcp_digest "${mcp_${mcp_dependency_role}_${mcp_digest_field}}")
        string(LENGTH "${mcp_digest}" mcp_digest_length)
        if(NOT mcp_digest MATCHES "^[0-9a-f]+$" OR NOT mcp_digest_length EQUAL 64)
            message(FATAL_ERROR "Native MCP ${mcp_dependency_role} ${mcp_digest_field} must be a SHA-256 digest")
        endif()
    endforeach()
    if(NOT mcp_${mcp_dependency_role}_sourceUrl MATCHES "^https://" OR NOT mcp_${mcp_dependency_role}_notice MATCHES "^[A-Za-z0-9_-]+[.]txt$" OR mcp_${mcp_dependency_role}_notice IN_LIST mcp_dependency_notices)
        message(FATAL_ERROR "Native MCP ${mcp_dependency_role} requires an HTTPS source and a unique notice filename")
    endif()
    list(APPEND mcp_dependency_notices "${mcp_${mcp_dependency_role}_notice}")
endforeach()
string(JSON mcp_compiler_name GET "${mcp_dependency_record}" supportedBuild compiler)
string(JSON mcp_compiler_minimum GET "${mcp_dependency_record}" supportedBuild compilerMinimum)
if(NOT mcp_compiler_name STREQUAL "MSVC" OR NOT mcp_compiler_minimum MATCHES "^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$")
    message(FATAL_ERROR "Native MCP dependency record requires an MSVC compiler version")
endif()
if(NOT MSVC OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS "${mcp_compiler_minimum}")
    message(FATAL_ERROR "Native MCP requires MSVC ${mcp_compiler_minimum} or later; other toolchains are unverified")
endif()

if(POLICY CMP0169)
    cmake_policy(SET CMP0169 OLD)
endif()
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()

function(mcp_source_archive name role)
    FetchContent_Declare(${name} URL "${mcp_${role}_sourceUrl}" URL_HASH "SHA256=${mcp_${role}_archiveSha256}")
    FetchContent_GetProperties(${name})
    if(NOT ${name}_POPULATED)
        FetchContent_Populate(${name})
    endif()
    set(${name}_SOURCE_DIR "${${name}_SOURCE_DIR}" PARENT_SCOPE)
endfunction()

mcp_source_archive(mcp_boost http)
mcp_source_archive(mcp_json_source json)
mcp_source_archive(mcp_sqlite_source store)
mcp_source_archive(mcp_quickjs_source javascript)

add_library(mcp_json INTERFACE)
target_include_directories(mcp_json SYSTEM INTERFACE "${mcp_json_source_SOURCE_DIR}/single_include")

add_library(mcp_http INTERFACE)
target_include_directories(mcp_http SYSTEM INTERFACE "${mcp_boost_SOURCE_DIR}")
target_compile_definitions(mcp_http INTERFACE BOOST_ALL_NO_LIB WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0601)
target_link_libraries(mcp_http INTERFACE ws2_32 mswsock)

add_library(mcp_sqlite STATIC "${mcp_sqlite_source_SOURCE_DIR}/sqlite3.c")
target_include_directories(mcp_sqlite SYSTEM PUBLIC "${mcp_sqlite_source_SOURCE_DIR}")
target_compile_definitions(mcp_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_DQS=0 SQLITE_DEFAULT_FOREIGN_KEYS=1 SQLITE_OMIT_LOAD_EXTENSION)
set_target_properties(mcp_sqlite PROPERTIES UNITY_BUILD OFF)

add_library(mcp_quickjs STATIC
    "${mcp_quickjs_source_SOURCE_DIR}/dtoa.c"
    "${mcp_quickjs_source_SOURCE_DIR}/libregexp.c"
    "${mcp_quickjs_source_SOURCE_DIR}/libunicode.c"
    "${mcp_quickjs_source_SOURCE_DIR}/quickjs.c")
target_include_directories(mcp_quickjs SYSTEM PUBLIC "${mcp_quickjs_source_SOURCE_DIR}")
target_compile_definitions(mcp_quickjs PRIVATE QUICKJS_NG_BUILD _GNU_SOURCE WIN32_LEAN_AND_MEAN _WIN32_WINNT=0x0601)
target_compile_features(mcp_quickjs PRIVATE c_std_11)
set_target_properties(mcp_quickjs PROPERTIES UNITY_BUILD OFF)
if(MSVC)
    target_compile_options(mcp_quickjs PRIVATE /experimental:c11atomics)
endif()

set(mcp_notice_directory "${CMAKE_BINARY_DIR}/mcp-notices")
file(MAKE_DIRECTORY "${mcp_notice_directory}")
function(mcp_copy_notice role source)
    file(SHA256 "${source}" digest)
    if(NOT digest STREQUAL "${mcp_${role}_noticeSha256}")
        message(FATAL_ERROR "Native MCP ${role} notice does not match its recorded SHA-256")
    endif()
    configure_file("${source}" "${mcp_notice_directory}/${mcp_${role}_notice}" COPYONLY)
endfunction()
mcp_copy_notice(http "${mcp_boost_SOURCE_DIR}/LICENSE_1_0.txt")
mcp_copy_notice(json "${mcp_json_source_SOURCE_DIR}/LICENSE.MIT")
mcp_copy_notice(javascript "${mcp_quickjs_source_SOURCE_DIR}/LICENSE")
mcp_copy_notice(store "${CMAKE_CURRENT_LIST_DIR}/notices/sqlite.txt")

file(GLOB_RECURSE mcp_contract_inputs CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/common/*"
    "${CMAKE_CURRENT_LIST_DIR}/broker/*"
    "${CMAKE_CURRENT_LIST_DIR}/connect/*"
    "${PROJECT_SOURCE_DIR}/src/dbg/mcp/*")
list(APPEND mcp_contract_inputs "${CMAKE_CURRENT_LIST_FILE}" "${CMAKE_CURRENT_LIST_DIR}/dependencies.json" "${PROJECT_SOURCE_DIR}/cmake.toml")
list(SORT mcp_contract_inputs)
set(mcp_build_input "${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_SIZEOF_VOID_P};${CMAKE_BUILD_TYPE};${CMAKE_MSVC_RUNTIME_LIBRARY};${CMAKE_CXX_FLAGS};${CMAKE_CXX_FLAGS_RELEASE}")
foreach(mcp_input IN LISTS mcp_contract_inputs)
    file(SHA256 "${mcp_input}" mcp_input_hash)
    string(APPEND mcp_build_input ";${mcp_input_hash}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${mcp_input}")
endforeach()
string(SHA256 MCP_BUILD_ID "${mcp_build_input}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/common/build_identity.h.in" "${CMAKE_BINARY_DIR}/mcp-generated/build_identity.h" @ONLY)
target_include_directories(mcp_json INTERFACE "${CMAKE_BINARY_DIR}/mcp-generated")

file(READ "${CMAKE_CURRENT_LIST_DIR}/common/legacy_aliases.json" MCP_LEGACY_ALIAS_SOURCE)
string(FIND "${MCP_LEGACY_ALIAS_SOURCE}" ")mcp_legacy_json\"" mcp_legacy_delimiter)
if(NOT mcp_legacy_delimiter EQUAL -1)
    message(FATAL_ERROR "Native MCP legacy alias source contains the reserved C++ literal delimiter")
endif()
set(mcp_legacy_literal_chunk_limit 4096)
string(LENGTH "${MCP_LEGACY_ALIAS_SOURCE}" mcp_legacy_source_length)
set(MCP_LEGACY_ALIAS_CHUNKS "")
set(mcp_legacy_source_offset 0)
while(mcp_legacy_source_offset LESS mcp_legacy_source_length)
    math(EXPR mcp_legacy_remaining "${mcp_legacy_source_length} - ${mcp_legacy_source_offset}")
    if(mcp_legacy_remaining GREATER mcp_legacy_literal_chunk_limit)
        set(mcp_legacy_remaining ${mcp_legacy_literal_chunk_limit})
    endif()
    string(SUBSTRING "${MCP_LEGACY_ALIAS_SOURCE}" ${mcp_legacy_source_offset} ${mcp_legacy_remaining} mcp_legacy_chunk)
    string(APPEND MCP_LEGACY_ALIAS_CHUNKS "R\"mcp_legacy_json(${mcp_legacy_chunk})mcp_legacy_json\",\n")
    math(EXPR mcp_legacy_source_offset "${mcp_legacy_source_offset} + ${mcp_legacy_remaining}")
endwhile()
configure_file("${CMAKE_CURRENT_LIST_DIR}/common/legacy_aliases.h.in" "${CMAKE_BINARY_DIR}/mcp-generated/legacy_alias_source.h" @ONLY)
